    {
      "id": "emerging_device_categories",
      "name": "新兴品类与端侧 AI",
      "topic": "emerging_device_categories"
    }
  ],
  "evidence_policy": {
    "classes": [
      {
        "id": "primary_disclosure",
        "name": "官方披露",
        "daily_label": "官方",
        "use_for": ["产品发布", "财报与指引", "监管与海关统计", "公司公告"],
        "rule": "可陈述为已确认事实，但需保留原始链接和发布日期。"
      },
      {
        "id": "market_data",
        "name": "第三方数据与研究",
        "daily_label": "数据/研究",
        "use_for": ["出货量", "份额", "ASP", "零售与渠道", "零部件供需预测"],
        "rule": "必须注明机构、统计口径、地区、时间范围和预测/实绩属性；付费报告只引用公开摘要。"
      },
      {
        "id": "industry_reporting",
        "name": "专业报道与分析",
        "daily_label": "报道/分析",
        "use_for": ["供应链访谈", "产品路线", "平台与商业模式", "行业解释"],
        "rule": "将消息来源归因给报道机构或分析者；若涉及未公开订单、供应商或销量，只能写为其报道/判断。"
      },
      {
        "id": "early_signal",
        "name": "早期信号与爆料",
        "daily_label": "线索/传闻",
        "use_for": ["研发线索", "未发布规格", "备货传闻", "新品时间表"],
        "rule": "必须显式标为线索或传闻，不得单独作为确认事实或定量结论的依据。"
      },
      {
        "id": "review_feedback",
        "name": "评测、创作者与用户反馈",
        "daily_label": "评测/口碑",
        "use_for": ["产品体验", "可用性", "上市后的舆情与评价"],
        "rule": "用于解释体验与市场反应，不能外推为全市场销量、供应链订单或普遍消费者结论。"
      }
    ],
    "corroboration_rules": [
      "单个早期信号需由至少两个相互独立的来源佐证，或由后续官方披露支持，才能升级为已验证事件。",
      "同一新闻稿、同一匿名消息源的转述不视为独立佐证。",
      "供应商名单、订单、备货与产能信息优先等待公司公告、财报电话会、海关数据或至少一家专业产业链媒体的可追溯报道。",
      "评测和 KOL 观点必须保留来源归属；存在明显赞助、样机限制或利益关系时应降权或标注。"
    ],
    "daily_composition": {
      "selection_principle": "不设置地区、来源、证据类别或栏目数量配额；只依据重要性、证据强度、新颖性和去重结果组织日报。",
      "duplicate_event_rule": "同一事件优先保留证据等级最高的一个主条目，其他来源作为佐证链接。"
    }
  },
  "ranking_rules": {
    "must_keep": [
      "重大新品、产品线或价格策略变化",
      "真实出货、库存、份额、ASP 或渠道数据",
      "品牌与供应商之间的订单、设计导入或产能变化",
      "AI 终端的量产、销售、使用反馈或关键技术进展",
      "财报、业绩指引、资本开支与监管限制"
    ],
    "deprioritize": [
      "无新增信息的营销内容",
      "单纯转发、庆祝、抽奖和个人生活内容",
      "没有来源或无法判断时间的信息",
      "与消费电子、端侧 AI 或产业链无实质关联的泛科技内容"
    ]
  }
}
