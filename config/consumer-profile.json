  "top_level_topics": [
    {
      "id": "brand_product_lifecycle",
      "name": "终端品牌：研发、上市与市场评价",
      "signals": ["product", "market_reception"],
      "questions": [
        "品牌正在研发或规划什么新品与产品路线？",
        "新品的规格、定价、上市节奏和渠道策略是否改变竞争格局？",
        "发布后的媒体评测、消费者反馈和早期销售表现如何？"
      ]
    },
    {
      "id": "supply_chain_technology",
      "name": "供应链、备货与新技术",
      "signals": ["supply_chain", "components"],
      "questions": [
        "哪些供应商获得设计导入，品牌如何调整供应链名单？",
        "备货、订单、产能、库存和交期传递了怎样的需求信号？",
        "芯片、显示、光学、摄像头、电池和结构件有哪些技术升级？"
      ]
    },
    {
      "id": "industry_supply_demand",
      "name": "行业供给、需求与渠道",
      "signals": ["demand", "financials", "competition_policy"],
      "questions": [
        "各品类的出货、份额、ASP、库存和价格处于什么周期？",
        "零售、电商、运营商和地区渠道是否出现边际变化？",
        "品牌、供应商与分析机构对未来需求和供给的判断有何分歧？"
      ]
    },
    {
      "id": "emerging_device_categories",
      "name": "新兴品类与端侧 AI",
      "signals": ["ai_terminal", "product", "market_reception"],
      "questions": [
        "AI PC、AI 手机、AI 眼镜、XR、智能音箱等新品类的关键进展是什么？",
        "它们的核心交互、端侧能力、成本结构和供应链是否趋于成熟？",
        "真实用户需求、出货与商业化是否已获得验证？"
      ]
    }
  ],
  "editorial_sections": [
    {
      "id": "brand_product_lifecycle",
      "name": "终端品牌：研发、上市与市场评价",
      "topic": "brand_product_lifecycle"
    },
    {
      "id": "supply_chain_technology",
      "name": "供应链、备货与新技术",
      "topic": "supply_chain_technology"
