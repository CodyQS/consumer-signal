{
  "id": "consumer_electronics",
  "project_name": "Consumer Signal",
  "display_name": "Consumer Signal 消费电子日报",
  "version": 1,
  "scope": {
    "languages": ["zh", "en"],
    "public_sources_only": true,
    "coverage_principle": "不设置地区、品牌、品类或来源类型的预设比例；按信息重要性、证据强度、新颖性和对消费电子行业的解释力入选。",
    "regions": ["global", "china", "taiwan_asia"],
    "primary_audience": "关注全球消费电子品牌、端侧 AI 与中国产业链变化的研究者和投资者"
  },
