{
  "profile": "consumer_electronics",
  "llm": {
    "provider": "deepseek",
    "api_key_env": "DEEPSEEK_API_KEY",
    "base_url": "https://api.deepseek.com/chat/completions",
    "model": "deepseek-v4-pro",
    "temperature": 0.2,
    "max_tokens": 1024,
    "timeout_seconds": 120
  },
  "output": {
    "dir": "content/summaries",
    "index_path": "feeds/feed-summaries.json"
  },
  "default_profiles": ["zh_standard"],
  "profiles": {
    "zh_standard": {
      "language": "zh",
      "detail": "standard",
      "target_chars": 600,
      "x_target_chars": 220,
      "article_target_chars": 420,
      "include_x": true,
      "include_articles": true,
      "domains": ["consumer_electronics"]
    },
    "en_standard": {
      "language": "en",
      "detail": "standard",
      "target_chars": 520,
      "x_target_chars": 200,
      "article_target_chars": 360,
      "include_x": true,
      "include_articles": true,
      "domains": ["consumer_electronics"]
    },
    "bilingual_short": {
      "language": "bilingual",
      "detail": "short",
      "target_chars": 500,
      "x_target_chars": 260,
      "article_target_chars": 460,
      "include_x": true,
      "include_articles": true,
      "domains": ["consumer_electronics"]
    }
  },
  "x": {
    "enabled": true,
    "input_path": "feeds/feed-x.json"
  },
  "articles": {
    "enabled": true,
    "input_path": "feeds/feed-blogs.json"
  }
}
